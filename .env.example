# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://yieldlens:yieldlens@localhost:5432/yieldlens
DATABASE_URL_SYNC=postgresql://yieldlens:yieldlens@localhost:5432/yieldlens

# ── FRED API ──────────────────────────────────────────────────────────────────
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── OpenAI (for LLM generation) ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_FINAL_K=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=yieldlens-eval

# ── Federal Reserve scraper ───────────────────────────────────────────────────
FED_SCRAPER_DELAY_SECONDS=1.5
FED_BASE_URL=https://www.federalreserve.gov
FOMC_CALENDAR_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm

# ── API ───────────────────────────────────────────────────────────────────────
API_SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

